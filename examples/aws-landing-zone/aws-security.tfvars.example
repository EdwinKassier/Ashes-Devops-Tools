# aws-security — security tooling, log archive, org CloudTrail (phase-2).
# Reference only. Canonical template: envs/aws/security/terraform.tfvars.example.
#
# Every input of envs/aws/security has a default; the values come from
# config/landing-zone.yaml. The keys below are OPTIONAL explicit overrides
# (tfvars or a TFC workspace variable win over the config file).

# Required effective values (config key -> variable):
# landing_zone_name     = "acme"         # org.name
# tfc_organization      = "acme-tfc-org" # org.tfc.organization (also the backend's TF_CLOUD_ORGANIZATION)
# management_account_id = "111111111111" # aws.management_account_id (quoted)

# Tuning inputs go in ONE object: unset keys keep the config value (or the
# profile-driven default).
# aws_overrides = {
#   # aws.log_archive_bucket_name — this root creates the bucket; it must match
#   # the name the aws-organization deny-tamper SCP protects.
#   log_archive_bucket_name = "acme-org-log-archive"
#
#   # Bring-your-own operator roles. Leave unset (the usual case): the stage
#   # uses each account's tfc-apply role as KMS key admin, creates the AWS
#   # Config recorder service-linked role and the aggregator role, and creates
#   # the Security Lake V2 meta-store manager role.
#   # key_admin_arn               = "arn:aws:iam::222222222222:role/key-admin"
#   # config_role_arn             = "arn:aws:iam::222222222222:role/aws-config-recorder"
#   # aggregator_role_arn         = "arn:aws:iam::222222222222:role/aws-config-aggregator"
#   # meta_store_manager_role_arn = "arn:aws:iam::222222222222:role/service-role/AmazonSecurityLakeMetaStoreManagerV2"
# }

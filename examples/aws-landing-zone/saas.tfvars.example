# saas — Supabase and/or Vercel only (phase-8, optional). NO aws/google provider,
# so NO cloud credentials are needed. Select the workspace with
# TF_WORKSPACE=saas-<name>.
# Reference only. Canonical (three-stanza) template: envs/saas/terraform.tfvars.example.
#
# NO variable of envs/saas is UNCONDITIONALLY required — everything is gated
# behind enable_supabase / enable_vercel and defaults are supplied so the
# both-false case validates. In a TFC run the toggles and IDs come from
# config/landing-zone.yaml (saas.supabase / saas.vercel, saas.defaults and
# saas.stacks.<name>), so the keys below are OPTIONAL explicit overrides. Each
# feature you TURN ON makes a set of inputs required (enforced by gated
# validations in the root). Provide the matching token via env var only:
#   SUPABASE_ACCESS_TOKEN  (when enable_supabase = true)
#   VERCEL_API_TOKEN       (when enable_vercel   = true)

# --- Supabase enabled: these become required ---
# enable_supabase            = true
# supabase_organization_id   = "abcdefghijklmnop"          # >= 8 lowercase alnum
# supabase_project_name      = "my-app-prod"               # 3-64 chars
# supabase_database_password: >= 16 chars, sensitive. Never put it in a tfvars
# file: set TF_VAR_supabase_database_password locally, or a sensitive TFC
# workspace variable (tfc-admin workspace_variables).

# --- Vercel enabled: these become required ---
# enable_vercel       = true
# vercel_project_name = "my-app"
# vercel_team_id      = "team_abcdefghijklmno"
# vercel_github_repo  = "myorg/my-app"                     # "org/repo"

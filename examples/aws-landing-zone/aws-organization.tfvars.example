# aws-organization — org, OU tree, accounts, guardrails (phase-1, the producer root).
# Reference only. Canonical template: envs/aws/organization/terraform.tfvars.example.
#
# Every input of envs/aws/organization has a default, so nothing here is
# needed when config/landing-zone.yaml is filled in: the VCS-driven TFC run reads
# the values from it. The keys below are OPTIONAL explicit overrides (tfvars,
# TF_VAR_* or a TFC workspace variable win over the config file). Each comment
# names the config key the variable falls back to. The plan fails, naming that
# key, while an effective value is still unset or a placeholder.

# Required effective values (config key -> variable):
# landing_zone_name = "acme"         # org.name (the placeholders ashes / my-org are rejected)
# tfc_organization  = "acme-tfc-org" # org.tfc.organization (needed with the TFC OIDC baseline, on by default)

# management_account_id = "111111111111" # aws.management_account_id (quoted)

# Phase-0 management-account roles (aws-bootstrap runbook Step 2). Both are
# carved out of every guardrail deny statement.
# terraform_run_role_arn = "arn:aws:iam::111111111111:role/tfc-mgmt-apply" # aws.terraform_run_role_arn
# break_glass_role_arn   = "arn:aws:iam::111111111111:role/break-glass"    # aws.break_glass_role_arn

# Central log-archive bucket protected by the deny-tamper SCP. aws-security
# creates it, and aws-network reads the same aws.log_archive_bucket_name.
# log_archive_bucket_name = "acme-org-log-archive" # aws.log_archive_bucket_name

# Foundational SRA accounts (aws.accounts). The example.com placeholder emails
# are rejected: every root email must be real, unique and deliverable. See the
# env template for the full map shape (name, alternate_contacts, ...).
# accounts = {
#   log_archive      = { email = "aws+log-archive@acme.test", ou = "Security" }
#   security_tooling = { email = "aws+security-tooling@acme.test", ou = "Security" }
#   network          = { email = "aws+network@acme.test", ou = "Infrastructure" }
#   shared_services  = { email = "aws+shared-services@acme.test", ou = "Infrastructure" }
#   backup           = { email = "aws+backup@acme.test", ou = "Infrastructure" }
#   forensics        = { email = "aws+forensics@acme.test", ou = "Security" }
# }

# aws-identity — IAM Identity Center permission sets + assignments (phase-4).
# Reference only. Canonical template: envs/aws/identity/terraform.tfvars.example.
#
# Every input of envs/aws/identity has a default. permission_sets defaults to
# five sets: AdministratorAccess (break-glass), PlatformAdmin, Developer,
# SecurityAudit and ReadOnly. Group assignments by display name come from
# aws.identity.groups in config/landing-zone.yaml.
#
# PREREQUISITE (out-of-band, not a tfvar): IAM Identity Center must be enabled in
# the management account and delegated to the shared-services account first — see
# the bootstrap runbook, "MANUAL GATE — IAM Identity Center".

# Required effective values (config key -> variable):
# landing_zone_name = "acme"         # org.name
# tfc_organization  = "acme-tfc-org" # org.tfc.organization (reads the aws-organization workspace)

# Optional — bind Identity Store groups by ID instead of by name.
# assignments = {
#   admins-shared-services = {
#     permission_set = "PlatformAdmin"
#     principal_type = "GROUP"
#     principal_id   = "00000000-0000-0000-0000-000000000000" # Identity Store group ID
#     account_id     = "111111111111"                         # target account ID
#   }
# }

# aws-network — TGW hub, IPAM, inspection/egress VPCs, resolver (phase-3).
# Reference only. Canonical template: envs/aws/network/terraform.tfvars.example.
#
# Every input of envs/aws/network has a default; the values come from
# config/landing-zone.yaml (egress allowlist, VPN and spoke attachments under
# aws.network). The keys below are OPTIONAL explicit overrides.

# Required effective values (config key -> variable):
# landing_zone_name = "acme"         # org.name
# tfc_organization  = "acme-tfc-org" # org.tfc.organization (reads the aws-organization workspace)

# Central log-archive bucket for VPC flow logs and Network Firewall logs. It
# must match the name aws-organization and aws-security use.
# log_archive_bucket_name = "acme-org-log-archive" # aws.log_archive_bucket_name

# The CIDR plan, AZ spread and firewall / analyzer toggles have working
# defaults; see the env template to override the addressing plan.

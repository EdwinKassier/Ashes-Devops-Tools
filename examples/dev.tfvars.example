# ──────────────────────────────────────────────────────────────────────────────
# envs/gcp/workload — LOCAL-ONLY plan inputs (development environment)
#
# This file is NOT read by Terraform Cloud and is never needed for a VCS-driven
# run: those take their inputs from config/landing-zone.yaml (services and
# service teams live under gcp.environments.<env>) and the workspace variables
# that envs/tfc-admin sets. Use this file only for a read-only local plan:
#
#   make plan-gcp-workload APP_ENV=dev APP_VARS=examples/dev.tfvars.example
#   (without APP_VARS the plan uses config/landing-zone.yaml alone)
#
# Never apply from here (CLAUDE.md "State & Apply Rules"). Never commit secrets
# or real billing account IDs. All values below are placeholders.
# ──────────────────────────────────────────────────────────────────────────────

# ── Identity and placement come from config/landing-zone.yaml ────────────────
# project_prefix, environment, region, tfc_organization and the upstream
# workspace names are NOT set here: the root reads them from
# config/landing-zone.yaml (org.prefix, gcp.environments.<env>, org.tfc.*) and
# from the workspace variables tfc-admin writes. An explicit value here would
# override them. terraform_admin_email stays unset: plans run in HCP Terraform
# with the workspace's own plan identity (CLAUDE.md "State & Apply Rules").

# ── Networking ─────────────────────────────────────────────────────────────────
#
# NOTE: vpc_cidr_block is NOT a variable here — it is read from the gcp-projects
# workspace remote state via local.env_config.cidr_block, which comes from
# gcp.environments[<env>].cidr_block in config/landing-zone.yaml.
# Set the CIDR there, not here.

# VPC Flow Logs
log_config_flow_sampling        = 0.5
log_config_aggregation_interval = "INTERVAL_5_SEC"
vpc_flow_logs_retention_days    = 30

# ── Security features (off by default in dev, on in prod) ─────────────────────

enable_deletion_protection = false # set true in production
enable_cloud_armor         = false # set true when attaching an external LB
enable_owasp_rules         = false
enable_adaptive_protection = false
owasp_sensitivity          = 2

# ── VPC Service Controls (optional — start in dry-run) ────────────────────────

# Uncomment and configure to enable VPC-SC for this environment.
# vpc_sc_enable_dry_run      = true
# vpc_sc_perimeter_title     = "Dev Perimeter"
# vpc_sc_restricted_services = ["storage.googleapis.com", "bigquery.googleapis.com"]
# vpc_sc_ingress_policies    = []
# vpc_sc_egress_policies     = []

# ── Budgets ───────────────────────────────────────────────────────────────────

monthly_budget_limit = 500
budget_currency      = "USD"

# ── Labels ────────────────────────────────────────────────────────────────────

extra_labels = {
  cost-centre = "platform"
  owner       = "platform-team"
}

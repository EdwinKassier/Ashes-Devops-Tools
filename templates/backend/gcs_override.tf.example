# Self-managed state on Google Cloud Storage.
#
# Copy to the root you are applying as `backend_override.tf` (git-ignored by
# the repo's `*_override.tf` rule) and set the bucket. Terraform merges override
# files over the base configuration; an override `backend` block REPLACES the
# root's `cloud {}` block, so no HCP Terraform workspace is used.
#
#   cp templates/backend/gcs_override.tf.example envs/gcp/organization/backend_override.tf
#
# Use a distinct `prefix` per root (for example the old workspace name), and a
# bucket with versioning enabled, uniform bucket-level access and a CMEK.
# See docs/guides/self-managed-state.md.
terraform {
  backend "gcs" {
    bucket = "REPLACE-ME-tfstate"
    prefix = "gcp-organization"
  }
}

# Optional overrides. Shared values (landing_zone_name, tfc_organization,
# aws_region, owner/cost_center, account IDs, role ARNs, accounts, workload
# environments) are read from config/landing-zone.yaml when it exists, so a
# VCS-driven TFC run needs no tfvars; any variable set here (or in TFC) wins
# over the config file.
#
# Copy to terraform.tfvars and fill in. Inputs marked REQUIRED have no usable
# default — you MUST supply them. Select the workspace for this environment with
# TF_WORKSPACE, e.g. `export TF_WORKSPACE=aws-workload-dev`.

# REQUIRED unless org.name is set in config/landing-zone.yaml — landing-zone
# identifier written to the LandingZone tag. The upstream placeholders
# "ashes" / "my-org" are rejected.
landing_zone_name = "acme"

# REQUIRED — Terraform Cloud org that owns this root's workspace and the
# aws-organization + aws-network workspaces it reads. Usually passed to
# `terraform init` via backend.hcl / TF_CLI_ARGS_init rather than here.
# tfc_organization = "your-tfc-org-name"

# Optional — upstream workspaces this root reads remote state from.
organization_workspace_name = "aws-organization"
network_workspace_name      = "aws-network"

# REQUIRED — key into the aws-organization account_ids / tfc_*_role_arns maps for
# THIS env's workload account (the providers' allowed_account_ids guard). Under
# tfc-admin it is set on aws-workload-<env> from environments[<env>].aws_account_key.
workload_account_key = "workload_dev"

# Optional — deploy region (also the region the workload-account role is assumed
# in and the key used to pick the regional IPAM pool) and the enabled regions.
aws_region          = "eu-west-2"
aws_enabled_regions = ["eu-west-2"]

# Optional — spoke VPC CIDR (subnet math; actual CIDR allocated from shared IPAM).
vpc_cidr = "10.20.0.0/16"

# REQUIRED — central log-archive bucket name. MUST match the name the
# aws-organization and aws-network roots use (cross-root naming contract).
log_archive_bucket_name = "acme-org-log-archive"

# Optional — IAM role AWS Config assumes to record resources in this account.
# Default null: the account's AWS Config service-linked role
# (AWSServiceRoleForConfig) is used, created by this root unless
# create_config_service_linked_role = false (set false if the account already has it).
# config_role_arn = "arn:aws:iam::222222222222:role/config-recorder"

# Optional — bring your own CMK. Empty (default) creates a rotating workload CMK
# (alias/workload-<env>) for default EBS encryption, Session Manager and every
# app service (ECR, log groups, Aurora, RDS secret), with a key policy that
# admits CloudWatch Logs, ECR and the task execution roles.
# kms_key_arn = "arn:aws:kms:eu-west-2:222222222222:key/abcd-1234"

# Optional — deploy the per-workload edge (CloudFront + WAF in us-east-1).
enable_edge = false

# Optional — workload / cross-account IAM roles.
workload_roles = {}

# -----------------------------------------------------------------------------
# SaaS secret bridge (audit H9, hybrid option C) — opt-in, default off.
# When enabled, Supabase connection details from the named saas-<name> workspace
# are written into a Secrets Manager secret the ECS task role can read via
# valueFrom. See docs/architecture/saas-integration.md.
# -----------------------------------------------------------------------------
enable_saas_secret_bridge = false

# Example (uncomment and adapt):
# enable_saas_secret_bridge = true
# saas_workspace_name       = "saas-web"
# saas_secret_name          = "supabase-connection"
# saas_secret_reader_arns   = ["arn:aws:iam::222222222222:role/app-task-role"]

# -----------------------------------------------------------------------------
# App services — the application golden path (modules/aws/stages/app-services).
# Default {} creates nothing. Each entry = ECR repo + Fargate service behind the
# shared INTERNAL ALB + least-privilege task roles + KMS log group, plus an
# optional GitHub Actions deploy role (github) and Aurora PostgreSQL (database).
# The first task revision runs a public placeholder (port 8080) until CI deploys.
# Walkthrough: docs/guides/deploying-a-service.md.
# -----------------------------------------------------------------------------
services           = {}
enable_github_oidc = false

# Example (uncomment and adapt):
# enable_github_oidc = true   # creates the account's GitHub OIDC provider once
# services = {
#   orders = {
#     container_port    = 8080
#     cpu               = 512
#     memory            = 1024
#     desired_count     = 2
#     health_check_path = "/healthz"
#     path_patterns     = ["/orders", "/orders/*"]   # default: /<name>, /<name>/*
#     environment       = { LOG_LEVEL = "info" }
#     secrets           = { STRIPE_KEY = "arn:aws:secretsmanager:eu-west-2:222222222222:secret:orders/stripe-AbCdEf" }
#
#     # Deploy role trusted ONLY by repo:acme/orders:environment:dev (exact match).
#     github = { repository = "acme/orders" }
#     # ...or a branch:       github = { repository = "acme/orders", ref = "refs/heads/main" }
#     # ...or a customised sub claim (immutable ids / job_workflow_ref):
#     # github = { repository = "acme/orders", subject = "repository_owner_id:123:repository_id:456:environment:dev" }
#
#     database = {}   # Aurora PostgreSQL Serverless v2, RDS-managed password
#   }
# }

# Optional — public exposure (also aws.workload.app_ingress_mode in config):
# app_ingress_mode = "cloudfront_vpc_origin" # internal ALB behind CloudFront + WAF; no cert needed
# app_ingress_mode = "public_alb"            # internet-facing ALB + regional WAF; needs app_alb_certificate_arn
# app_edge_domain_name = "app.example.com"   # cloudfront_vpc_origin custom domain (ACM in us-east-1)

# Optional — shared ALB + alarms.
# app_alb_certificate_arn = "arn:aws:acm:eu-west-2:222222222222:certificate/abcd"  # HTTPS :443, :80 redirects
# app_alb_ingress_cidrs   = ["10.0.0.0/8"]   # default [vpc_cidr]; widen for other spokes via the TGW
# app_alarm_sns_topic_arn = "arn:aws:sns:eu-west-2:222222222222:workload-alarms"

# Stage contract overrides (optional; also settable as aws.contracts.<layer> in
# config/landing-zone.yaml). A supplied contract skips that remote-state read.
# organization_contract = { account_ids = { workload_dev = "222222222222" } }
# network_contract      = { tgw_id = "tgw-0123456789abcdef0", ipam_pool_ids = { "eu-west-2" = "ipam-pool-0123456789abcdef0" } }
# security_contract     = { log_archive_bucket_name = "my-org-org-log-archive" }
#
# Standalone spoke without the aws-network layer (no TGW, no IPAM, no egress):
# enable_network_hub = false

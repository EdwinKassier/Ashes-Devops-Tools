# Scaffold matrix: the committed scaffolder output for each cloud combination
# (tests/fixtures/scaffold/, regenerated by `make scaffold-fixtures`) must plan
# under mock providers. Operator-supplied IDs a production scaffold legitimately
# requires are passed as test variables, never by weakening a precondition.

mock_provider "aws" {}

mock_provider "aws" { alias = "security_tooling" }

mock_provider "aws" { alias = "log_archive" }

mock_provider "aws" { alias = "forensics" }

override_module {
  target  = module.aws_security.module.forensics_cmk
  outputs = { key_arn = "arn:aws:kms:eu-west-2:555555555555:key/forensics-0000" }
}

override_data {
  target = data.terraform_remote_state.aws_organization
  values = {
    outputs = {
      organization_id       = "o-abcdefghij"
      organization_root_id  = "r-abcd"
      management_account_id = "111111111111"
      account_ids = {
        security_tooling = "222222222222"
        log_archive      = "333333333333"
        shared_services  = "444444444444"
        forensics        = "555555555555"
      }
      account_role_arns = {
        security_tooling = "arn:aws:iam::222222222222:role/cross-account"
        log_archive      = "arn:aws:iam::333333333333:role/cross-account"
        forensics        = "arn:aws:iam::555555555555:role/cross-account"
      }
    }
  }
}


run "scaffold_aws_plans" {
  command = plan

  variables {
    landing_zone_config_path = "../../../tests/fixtures/scaffold/landing-zone.aws.yaml"
  }
}

run "scaffold_gcp_aws_plans" {
  command = plan

  variables {
    landing_zone_config_path = "../../../tests/fixtures/scaffold/landing-zone.gcp-aws.yaml"
  }
}

run "scaffold_gcp_aws_saas_plans" {
  command = plan

  variables {
    landing_zone_config_path = "../../../tests/fixtures/scaffold/landing-zone.gcp-aws-saas.yaml"
  }
}

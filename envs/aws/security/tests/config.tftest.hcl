# Scaffold matrix: the committed scaffolder output for each cloud combination
# (tests/fixtures/scaffold/, regenerated by `make scaffold-fixtures`) must plan
# under mock providers. Operator-supplied IDs a production scaffold legitimately
# requires are passed as test variables, never by weakening a precondition.

mock_provider "aws" {}

# CMP-6: a production scaffold needs a real security contact (notifications.emails,
# commented out in the scaffold); it is operator-supplied, so it is passed here.
variables {
  aws_overrides = {
    notification_subscribers = { secops = { protocol = "email", endpoint = "secops@acme.test" } }
  }
}

mock_provider "aws" { alias = "security_tooling" }

mock_provider "aws" { alias = "log_archive" }

mock_provider "aws" { alias = "forensics" }

override_module {
  target  = module.aws_security.module.forensics_cmk
  outputs = { key_arn = "arn:aws:kms:eu-west-2:555555555555:key/forensics-0000" }
}

override_data {
  target = data.terraform_remote_state.aws_organization
  values = {
    outputs = {
      contract = {
        organization_id       = "o-abcdefghij"
        organization_root_id  = "r-abcd"
        management_account_id = "111111111111"
        account_ids = {
          security_tooling = "222222222222"
          log_archive      = "333333333333"
          shared_services  = "444444444444"
          forensics        = "555555555555"
        }
        account_role_arns = {
          security_tooling = "arn:aws:iam::222222222222:role/cross-account"
          log_archive      = "arn:aws:iam::333333333333:role/cross-account"
          forensics        = "arn:aws:iam::555555555555:role/cross-account"
        }
      }
    }
  }
}


run "scaffold_aws_plans" {
  command = plan

  variables {
    landing_zone_config_path = "../../../tests/fixtures/scaffold/landing-zone.aws.yaml"
  }
}

run "scaffold_gcp_aws_plans" {
  command = plan

  variables {
    landing_zone_config_path = "../../../tests/fixtures/scaffold/landing-zone.gcp-aws.yaml"
  }
}

run "scaffold_gcp_aws_saas_plans" {
  command = plan

  variables {
    landing_zone_config_path = "../../../tests/fixtures/scaffold/landing-zone.gcp-aws-saas.yaml"
  }
}

# CMP-2: compliance.audit_log_retention_days feeds the log archive. The stage
# output reads the planned Object Lock default retention.
run "compliance_retention_feeds_log_archive" {
  command = plan

  variables {
    landing_zone_config_path = "tests/fixtures/landing-zone.compliance.yaml"
  }

  assert {
    condition     = local.aws.log_archive_retention_days == 2190 && module.aws_security.log_archive_retention_days == 2190
    error_message = "compliance.audit_log_retention_days must feed aws.log_archive_retention_days and the bucket."
  }
}

run "override_retention_beats_config" {
  command = plan

  variables {
    landing_zone_config_path = "tests/fixtures/landing-zone.compliance.yaml"
    aws_overrides            = { log_archive_retention_days = 2555, notification_subscribers = { secops = { protocol = "email", endpoint = "secops@acme.test" } } }
  }

  assert {
    condition     = module.aws_security.log_archive_retention_days == 2555
    error_message = "aws_overrides.log_archive_retention_days must win over compliance.audit_log_retention_days."
  }
}

# No compliance section: the archive keeps 365 days.
run "log_archive_retention_default_unchanged" {
  command = plan

  variables {
    landing_zone_config_path = "tests/fixtures/landing-zone.yaml"
  }

  assert {
    condition     = module.aws_security.log_archive_retention_days == 365
    error_message = "without a compliance section the log archive must keep 365 days."
  }
}

# Optional overrides. Shared values (landing_zone_name, tfc_organization,
# aws_region, owner/cost_center, account IDs, role ARNs, accounts, workload
# environments) are read from config/landing-zone.yaml when it exists, so a
# VCS-driven TFC run needs no tfvars; any variable set here (or in TFC) wins
# over the config file.
#
# Copy to terraform.tfvars and fill in. Inputs marked REQUIRED have no usable
# default — you MUST supply them (the two role ARNs, the log-archive bucket
# name, and real root emails for every account).

# REQUIRED unless org.name is set in config/landing-zone.yaml — landing-zone
# identifier written to the LandingZone tag. The upstream placeholders
# "ashes" / "my-org" are rejected.
landing_zone_name = "acme"

# NB: the Terraform Cloud org that owns this root's workspace is a BACKEND config
# value, not a tfvars input. Export TF_CLOUD_ORGANIZATION=<your-tfc-org> before
# `terraform init` (see backend.tf).

# Optional — primary region for the default (management-account) provider.
aws_region = "eu-west-2"

# Optional — regions permitted by the region-restriction SCP.
allowed_regions = ["eu-west-2"]

# REQUIRED — foundational member accounts. The keys default to the six SRA
# accounts, but the placeholder emails below MUST be replaced with real, unique,
# deliverable root addresses (AWS rejects duplicate root emails). Set the `ou`
# to an OU name that exists in the organization OU tree.
accounts = {
  log_archive      = { email = "aws+log-archive@ashes.example.com", ou = "Security" }
  security_tooling = { email = "aws+security-tooling@ashes.example.com", ou = "Security" }
  network          = { email = "aws+network@ashes.example.com", ou = "Infrastructure" }
  shared_services  = { email = "aws+shared-services@ashes.example.com", ou = "Infrastructure" }
  backup           = { email = "aws+backup@ashes.example.com", ou = "Infrastructure" }
  forensics        = { email = "aws+forensics@ashes.example.com", ou = "Security" }
}

# Optional — additional workload accounts, merged with `accounts`.
# workload_accounts = {
#   sandbox = { email = "aws+sandbox@ashes.example.com", ou = "Workloads" }
# }

# REQUIRED — the MANAGEMENT-account TFC apply role you hand-created in phase-0
# (docs/runbooks/aws-bootstrap.md Step 2). Carved out of every guardrail deny
# statement so automation is not locked out. Same ARN as tfc-admin's
# aws_management_apply_role_arn.
terraform_run_role_arn = "arn:aws:iam::111111111111:role/tfc-mgmt-apply"

# REQUIRED — the management-account break-glass role: hand-created in phase-0,
# or the role aws-security will create with create_break_glass = true
# (arn:aws:iam::<mgmt>:role/OrganizationBreakGlass by default).
break_glass_role_arn = "arn:aws:iam::111111111111:role/break-glass"

# REQUIRED — central log-archive S3 bucket protected by the deny-tamper SCP.
log_archive_bucket_name = "ashes-org-log-archive"

# ---------------------------------------------------------------------------
# Cost governance (management-account-scoped). All optional — defaults work.
# ---------------------------------------------------------------------------

# Optional — set false to disable budgets, Cost Anomaly Detection and cost-
# allocation-tag activation entirely.
enable_cost_governance = true

# Optional — monthly COST budgets. Override the limit and add real email
# subscribers before relying on the notifications.
budgets = {
  org-monthly = { limit_amount = "1000", threshold_percent = 80, emails = ["finops@ashes.example.com"] }
}

# Optional — tag keys activated as cost-allocation tags (should mirror the
# tag-policy keys).
cost_allocation_tags = ["CostCenter", "Environment", "Owner"]

# Optional — SNS topic that budget notifications also publish to.
# cost_notifications_topic_arn = "arn:aws:sns:eu-west-2:111111111111:cost-alerts"

# Optional — address that receives Cost Anomaly Detection alerts.
cost_anomaly_email = "finops@ashes.example.com"

# ---------------------------------------------------------------------------
# Terraform Cloud OIDC baseline (member-account workload identity)
# ---------------------------------------------------------------------------

# REQUIRED while enable_tfc_oidc_baseline = true (the default) — the TFC
# organization whose workspaces the member-account tfc-plan / tfc-apply roles
# trust. Matched literally in every trust policy.
tfc_organization = "ashes"

# Optional — TFC project the workspaces live in (literal match in the sub claim).
# Default: org.tfc.aws_project from config/landing-zone.yaml, else
# "<org.tfc.project_name_prefix>aws" = "landing-zone-aws", the project tfc-admin
# puts the aws-* workspaces in. Override only if your workspaces live elsewhere,
# or every tfc-plan / tfc-apply AssumeRole is denied.
# tfc_project = "landing-zone-aws"

# Optional — account key -> bound workspaces. Default: the six foundational
# bindings plus one per aws.workload_environments entry in the config file.
# Setting it replaces that derivation, so then add one entry per workload account.
# tfc_workspace_bindings = {
#   security_tooling = { workspaces = ["aws-security"] }
#   log_archive      = { workspaces = ["aws-security"] }
#   forensics        = { workspaces = ["aws-security"] }
#   network          = { workspaces = ["aws-network"] }
#   shared_services  = { workspaces = ["aws-identity", "aws-shared-services"] }
#   backup           = { workspaces = ["aws-backup"] }
#   workload_dev     = { workspaces = ["aws-workload-dev"] }
# }

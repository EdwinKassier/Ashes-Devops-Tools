# Scaffold matrix: the committed scaffolder output for each cloud combination
# (tests/fixtures/scaffold/, regenerated by `make scaffold-fixtures`) must plan
# under mock providers. Operator-supplied IDs a production scaffold legitimately
# requires are passed as test variables, never by weakening a precondition.
# Each run also asserts that config-file values (which differ from the built-in
# defaults) resolve into the root's locals and its remote-state read.

mock_provider "aws" {}

mock_provider "aws" { alias = "backup" }

override_data {
  target = data.terraform_remote_state.aws_organization
  values = {
    outputs = {
      contract = {
        ou_ids = {
          Workloads = "ou-abcd-workloads0"
        }
        account_ids = { backup = "444444444444" }
        account_role_arns = {
          backup = "arn:aws:iam::444444444444:role/cross-account"
        }
      }
    }
  }
}

run "scaffold_aws_plans" {
  command = plan

  variables {
    landing_zone_config_path = "../../../tests/fixtures/scaffold/landing-zone.aws.yaml"
  }

  assert {
    condition     = local.landing_zone_name == "acme-lz" && local.tfc_organization == "acme-lz"
    error_message = "org.name and org.tfc.organization from the config file must resolve into the root locals."
  }

  assert {
    condition     = data.terraform_remote_state.aws_organization[0].config.organization == "acme-lz"
    error_message = "the aws-organization remote-state read must use the config-file TFC organization."
  }

  assert {
    condition     = local.management_account_id == "123456789012"
    error_message = "aws.management_account_id from the config file must resolve into the root locals."
  }
}


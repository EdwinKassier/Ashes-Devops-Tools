# Scaffold matrix: the committed scaffolder output for each cloud combination
# (tests/fixtures/scaffold/, regenerated by `make scaffold-fixtures`) must plan
# under mock providers. Operator-supplied IDs a production scaffold legitimately
# requires are passed as test variables, never by weakening a precondition.
# Each run also asserts that config-file values (which differ from the built-in
# defaults) resolve into the root's locals and its remote-state read.

# The root reads data.aws_availability_zones when no zone names are set (azs.tf).
mock_provider "aws" {
  mock_data "aws_availability_zones" {
    defaults = {
      names    = ["eu-west-2a", "eu-west-2b", "eu-west-2c"]
      zone_ids = ["euw2-az2", "euw2-az3", "euw2-az1"]
    }
  }
}

variables {
  # A production estate needs a real alarm contact. The other fixtures have no
  # notifications.emails, so the suite passes one here. The scaffold runs clear
  # it (null): the scaffolder writes notifications.emails.
  alarm_subscriber_emails = ["netops@acme-corp.io"]
}

override_data {
  target = data.terraform_remote_state.aws_organization
  values = {
    outputs = {
      contract = {
        organization_id       = "o-abcdefghij"
        management_account_id = "111111111111"
        account_ids           = { network = "666666666666" }
        account_role_arns = {
          network = "arn:aws:iam::666666666666:role/cross-account"
        }
      }
    }
  }
}

run "scaffold_aws_plans" {
  command = plan

  variables {
    landing_zone_config_path = "../../../tests/fixtures/scaffold/landing-zone.aws.yaml"
    alarm_subscriber_emails  = null
  }

  # ADO-21: the scaffolder writes notifications.emails (--notification-emails),
  # so the production scaffold plans with no test-supplied alarm subscriber.
  assert {
    condition     = local.alarm_subscriber_emails == tolist(["secops@acme-corp.io"])
    error_message = "the scaffold's notifications.emails must be the hub network alarm subscriber."
  }

  assert {
    condition     = local.landing_zone_name == "acme-lz" && local.tfc_organization == "acme-lz"
    error_message = "org.name and org.tfc.organization from the config file must resolve into the root locals."
  }

  assert {
    condition     = data.terraform_remote_state.aws_organization[0].config.organization == "acme-lz"
    error_message = "the aws-organization remote-state read must use the config-file TFC organization."
  }

  assert {
    condition     = local.log_archive_bucket_name == "acme-lz-org-log-archive" && local.profile == "production" && local.enable_network_firewall
    error_message = "aws.log_archive_bucket_name and org.profile from the config file must resolve (production keeps the Network Firewall on)."
  }

  assert {
    condition     = local.network_firewall_egress_domain_allowlist == tolist(["api.ecr.eu-west-2.amazonaws.com", ".dkr.ecr.eu-west-2.amazonaws.com", "secretsmanager.eu-west-2.amazonaws.com", ".github.com", ".githubusercontent.com", ".terraform.io"]) && local.network_firewall_stateful_default_actions == tolist(["aws:drop_established", "aws:alert_established"])
    error_message = "aws.network egress settings from the config file must reach the network-hub stage inputs."
  }
}


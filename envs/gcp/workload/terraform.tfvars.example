tfc_organization             = "your-tfc-org-name"
organization_workspace_name  = "gcp-organization"
terraform_admin_email        = "terraform-admin@your-project.iam.gserviceaccount.com"
project_prefix               = "myorg"
environment                  = "dev"
region              = "europe-west1"

# Budget
monthly_budget_limit         = 500
budget_currency              = "USD"

# Feature flags
enable_deletion_protection   = false
enable_cloud_armor           = false
enable_owasp_rules           = false
enable_adaptive_protection   = false
owasp_sensitivity            = 4

# Flow logs
log_config_flow_sampling        = 0.1
log_config_aggregation_interval = "INTERVAL_5_SEC"
vpc_flow_logs_retention_days    = 30

# Labels applied to all resources in this environment
extra_labels = {
  team        = "platform"
  cost-center = "engineering"
}

# VPC Service Controls
# vpc_sc_perimeter_title is optional; defaults to "<project_prefix>-<environment>-perimeter"
# vpc_sc_perimeter_title = "my-custom-perimeter-title"
vpc_sc_enable_dry_run = true

vpc_sc_restricted_services = [
  "bigquery.googleapis.com",
  "storage.googleapis.com",
  "secretmanager.googleapis.com",
  "cloudkms.googleapis.com",
  "pubsub.googleapis.com",
  "sqladmin.googleapis.com",
  "container.googleapis.com",
  "artifactregistry.googleapis.com",
]

# Ingress policies allow specific identities/sources into the perimeter.
# Leave empty to deny all inbound cross-perimeter traffic.
vpc_sc_ingress_policies = []

# Egress policies allow specific identities to reach resources outside the perimeter.
# Leave empty to deny all outbound cross-perimeter traffic.
vpc_sc_egress_policies = []

# -----------------------------------------------------------------------------
# Service team registry (audit H10)
#
# Onboard a team by adding an entry here, not by editing main.tf. Default is no
# teams. Promote a team to the next environment by copying its entry into that
# environment's tfvars (see docs/runbooks/promotion.md).
# -----------------------------------------------------------------------------
service_teams = {}

# Example (uncomment and adapt):
# service_teams = {
#   payments = {
#     project_admin_group_email = "payments-admins@company.com"
#     activate_apis             = ["run.googleapis.com", "sqladmin.googleapis.com"]
#     project_admin_roles       = ["roles/run.developer", "roles/cloudsql.client"]
#     # Grant the subnets this team needs. Subnet names are per-zone:
#     #   <project_prefix>-<environment>-vpc-private-<region>-<zone>
#     shared_vpc_subnets = {
#       private = { region = "europe-west1", subnet_name = "ashes-dev-vpc-private-europe-west1-b" }
#     }
#     # enable_gke_network_user = true   # only for GKE projects
#   }
# }

# -----------------------------------------------------------------------------
# SaaS secret bridge (audit H9, hybrid option C) — opt-in, default off.
# When enabled, Supabase connection details from the named saas-<name> workspace
# are written into a Secret Manager secret the runtime SA can read.
# See docs/architecture/saas-integration.md.
# -----------------------------------------------------------------------------
enable_saas_secret_bridge = false

# Example (uncomment and adapt):
# enable_saas_secret_bridge    = true
# saas_workspace_name          = "saas-web"
# saas_secret_name             = "supabase-connection"
# saas_secret_accessor_members = ["serviceAccount:app@ashes-dev-host-xxxx.iam.gserviceaccount.com"]

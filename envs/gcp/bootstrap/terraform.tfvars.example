# gcp-bootstrap root — example variables.
# Apply this root BEFORE gcp-organization (it produces the admin project,
# Terraform admin SA, and WIF pools the other GCP roots read via remote state).

# Organization and billing
domain          = "example.com"
billing_account = "000000-000000-000000" # OR set billing_account_display_name
# billing_account_display_name = "My Billing Account"

# Naming
project_prefix = "verify-org"

# Administrator
admin_email = "admin@example.com"

# Terraform Cloud (dynamic credentials / WIF trust)
tfc_organization = "your-tfc-org-name"
enable_tfc_oidc  = true

# Optional hardening of the TFC trust (audit C2): pin immutable IDs.
# tfc_organization_id = "org-XXXXXXXXXXXXXXXX"
# tfc_project_ids     = ["prj-XXXXXXXXXXXXXXXX"]
# tfc_workspace_ids = {           # once envs/tfc-admin has created the workspaces
#   "gcp-organization" = "ws-XXXXXXXXXXXXXXXX"
# }

# GitHub OIDC — OFF by default (no workflow uses it). When enabled it is bound to
# the read-only organization plan SA only, on immutable numeric IDs.
# enable_github_wif          = true
# github_org                 = "MyOrg"
# github_repo                = "devops-infra"
# github_repository_id       = "123456789"  # GET /repos/MyOrg/devops-infra -> .id
# github_repository_owner_id = "987654321"  # ... -> .owner.id

# Leave terraform_admin_email unset (null) in TFC and on the phase-0 first apply.
# Only a LOCAL human re-apply should impersonate the admin SA:
# terraform_admin_email = "terraform-admin@<admin-project-id>.iam.gserviceaccount.com"

# Environments — only the KEYS are used here (each key gets its own
# <prefix>-wl-<env>-plan / -apply SA pair, bound to TFC workspace gcp-workload-<env>). Keep this in sync with the same
# variable on the gcp-organization root.
environments = {
  dev = {
    display_name            = "Development"
    region                  = "europe-west1"
    cidr_block              = "10.10.0.0/16"
    budget_monthly_limit    = 100
    iam_group_role_bindings = {}
  }
}

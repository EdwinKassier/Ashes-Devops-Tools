# Single source: every value below that has a config/landing-zone.yaml key
# (project_prefix, environments, tfc_organization, regions, ...) is read from
# that committed file when left unset here. Set it here only to OVERRIDE it
# (explicit variable > config file > built-in default). The gcp.* keys and every
# other tuning input go in ONE object, gcp_overrides (bottom of this file): set
# only the keys you override, unset keys keep the config value.

# Organization Configuration
domain            = "example.com"
organization_name = "My Company"
billing_account   = "000000-000000-000000" # OR use billing_account_display_name
tfc_organization  = "your-tfc-org-name"

# Project Naming
project_prefix = "verify-org"

# Optional: Grant shared services folder access to existing groups
# shared_iam_group_role_bindings = {
#   "gcp-shared-netops@example.com" = [
#     "roles/compute.networkAdmin",
#     "roles/dns.admin"
#   ]
# }

environments = {
  dev = {
    display_name         = "Development"
    region               = "europe-west1"
    cidr_block           = "10.10.0.0/16"
    budget_monthly_limit = 500
    iam_group_role_bindings = {
      "gcp-dev-platform@example.com" = [
        "roles/compute.networkUser",
        "roles/logging.viewer"
      ]
    }
    labels = {
      criticality = "low"
    }
  }
  uat = {
    display_name         = "UAT"
    region               = "europe-west1"
    cidr_block           = "10.20.0.0/16"
    budget_monthly_limit = 1000
    iam_group_role_bindings = {
      "gcp-uat-platform@example.com" = [
        "roles/compute.networkUser",
        "roles/logging.viewer"
      ]
    }
    labels = {
      criticality = "medium"
    }
  }
  prod = {
    display_name         = "Production"
    region               = "europe-west1"
    cidr_block           = "10.30.0.0/16"
    budget_monthly_limit = 5000
    iam_group_role_bindings = {
      "gcp-prod-platform@example.com" = [
        "roles/compute.networkUser",
        "roles/logging.viewer"
      ]
    }
    labels = {
      criticality = "high"
    }
  }
}

# Regions
default_region = "europe-west1"

# Hub network CIDRs — must be set explicitly; no defaults to prevent CIDR collisions
hub_vpc_cidr_block     = "10.0.0.0/16"
dns_hub_vpc_cidr_block = "10.1.0.0/16"

# GitHub OIDC (github_org / github_repo), enable_tfc_oidc and
# enable_privilege_split moved to the gcp-bootstrap root
# (envs/gcp/bootstrap/terraform.tfvars.example) when the bootstrap stage was
# split out (audit H3).

# Budget
# monthly_budget_amount = 1000

# gcp section overrides (each key wins over gcp.* in config/landing-zone.yaml).
gcp_overrides = {
  admin_email = "admin@example.com"

  # REQUIRED (here or as gcp.organization_admin_groups / gcp.billing_admin_groups
  # in config/landing-zone.yaml): standing admin is group-only, so at least one
  # group each, unless allow_user_principals_for_break_glass = true. Replace the
  # placeholders.
  organization_admin_groups = ["gcp-org-admins@example.com"]
  billing_admin_groups      = ["gcp-billing-admins@example.com"]

  allowed_regions = ["europe-west1", "europe-west2", "us-central1"]

  # Notifications (Optional)
  # security_contact_email = "security@example.com"
  # billing_contact_email  = "billing@example.com"
}

# Scaffold matrix: the committed scaffolder output for each cloud combination
# (tests/fixtures/scaffold/, regenerated by `make scaffold-fixtures`) must plan
# under mock providers. Operator-supplied IDs a production scaffold legitimately
# requires are passed as test variables, never by weakening a precondition.

mock_provider "google" {}

mock_provider "google-beta" {}

mock_provider "random" {}

override_data {
  target = data.terraform_remote_state.gcp_organization
  values = {
    outputs = {
      contract = {
        org_id = "123456789012"
        folders = {
          dev = { id = "folders/111", display_name = "Development" }
        }
      }
    }
  }
}

override_data {
  target = data.terraform_remote_state.gcp_projects
  values = {
    outputs = {
      contract = {
        project_ids = {
          "shared-hub" = "acme-hub-abcd"
          "shared-dns" = "acme-dns-abcd"
          "dev-host"   = "acme-dev-host-abcd"
          "prod-host"  = "acme-prod-host-abcd"
        }
        project_numbers = {
          "shared-hub" = "111111111111"
          "shared-dns" = "222222222222"
          "dev-host"   = "333333333333"
          "prod-host"  = "444444444444"
        }
      }
    }
  }
}

override_module {
  target = module.network_hub
  outputs = {
    hub_vpc_self_link = "https://www.googleapis.com/compute/v1/projects/acme-hub-abcd/global/networks/acme-hub-vpc"
    hub_vpc_name      = "acme-hub-vpc"
    dns_zone_name     = "hub-dns"
    hub_dns_domain    = "hub.internal."
  }
}


# vpc_sc_access_policy_name / vpc_sc_enable_dry_run are operator-supplied: the
# access policy is created out of band, so the scaffold cannot carry it. The
# check block hub_vpc_sc_enforced_when_prod_present only warns at plan time
# (terraform test reports a failed check as a failure), so each scaffold run
# supplies both to keep the production perimeter enforced.
run "scaffold_gcp_plans" {
  command = plan

  variables {
    landing_zone_config_path  = "../../../tests/fixtures/scaffold/landing-zone.gcp.yaml"
    vpc_sc_access_policy_name = "1234567890"
    vpc_sc_enable_dry_run     = false
  }
}

run "scaffold_gcp_aws_plans" {
  command = plan

  variables {
    landing_zone_config_path  = "../../../tests/fixtures/scaffold/landing-zone.gcp-aws.yaml"
    vpc_sc_access_policy_name = "1234567890"
    vpc_sc_enable_dry_run     = false
  }
}

run "scaffold_gcp_aws_saas_plans" {
  command = plan

  variables {
    landing_zone_config_path  = "../../../tests/fixtures/scaffold/landing-zone.gcp-aws-saas.yaml"
    vpc_sc_access_policy_name = "1234567890"
    vpc_sc_enable_dry_run     = false
  }
}

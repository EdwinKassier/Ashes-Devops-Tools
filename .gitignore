# Terraform files
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
# Written by `make bootstrap-ids` (immutable TFC workspace IDs; already covered by *.tfvars)
envs/gcp/bootstrap/tfc-workspaces.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Terraform plan files
*.tfplan
plan.out
terraform.plan
tfplan

# Agent/worktree scratch directories (never commit)
.claire/
.claude/worktrees/

# Lock files are intentionally committed so CI and all developers use the same
# provider versions. Generate with:
#   terraform providers lock -platform=linux_amd64 -platform=darwin_arm64 -platform=darwin_amd64
# !.terraform.lock.hcl

# Exclude all .tfvars files, which are likely to contain sensitive data.
# Exception: examples/*.tfvars and examples/presets/*.tfvars are template files with
# no real values. (The presets were silently ignored before this exception existed.)
*.auto.tfvars
*.auto.tfvars.json
!examples/*.tfvars
!examples/**/*.tfvars
# The security team's committed gcp-guardrails inputs (iam_deny_policies; no
# secrets). CODEOWNERS: platform + security.
!envs/gcp/guardrails/guardrails.auto.tfvars

# The single-source landing-zone configuration is COMMITTED (it holds no
# secrets) so VCS-driven Terraform Cloud runs read it. Never ignore it.
!config/landing-zone.yaml
!config/tfc-workspaces.yaml

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*

# Init file (contains sensitive project config)
init.tf

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyRunInstancesOutsideAllowlist",
      "Effect": "Deny",
      "Action": "ec2:RunInstances",
      "Resource": "arn:${partition}:ec2:*:*:instance/*",
      "Condition": {
        "StringNotLike": {
          "ec2:InstanceType": ${allowed_instance_types}
        },
        "ArnNotLike": {
          "aws:PrincipalArn": ${break_glass_arns}
        }
      }
    },
    {
      "Sid": "DenyNetworkEgressAndOrgEscape",
      "Effect": "Deny",
      "Action": [
        "directconnect:*",
        "ec2:CreateVpcPeeringConnection",
        "organizations:*"
      ],
      "Resource": "*",
      "Condition": {
        "ArnNotLike": {
          "aws:PrincipalArn": ${break_glass_arns}
        }
      }
    }
  ]
}

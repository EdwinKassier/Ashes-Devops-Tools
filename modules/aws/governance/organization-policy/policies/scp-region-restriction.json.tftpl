{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideAllowedRegions",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "organizations:*",
        "route53:*",
        "route53domains:*",
        "cloudfront:*",
        "waf:*",
        "wafv2:*",
        "shield:*",
        "globalaccelerator:*",
        "support:*",
        "trustedadvisor:*",
        "artifact:*",
        "budgets:*",
        "ce:*",
        "cur:*",
        "account:*",
        "savingsplans:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*",
        "health:*",
        "sts:*",
        "acm:*",
        "kms:*",
        "ec2:DescribeRegions",
        "pricing:*",
        "networkmanager:*",
        "notifications:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": ${allowed_regions}
        },
        "ArnNotLike": {
          "aws:PrincipalArn": ${break_glass_arns}
        }
      }
    },
    {
      "Sid": "EdgeCertificatesAndKeysOnlyInAllowedRegionsOrUsEast1",
      "Effect": "Deny",
      "Action": [
        "acm:*",
        "kms:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": ${allowed_regions_with_us_east_1}
        },
        "ArnNotLike": {
          "aws:PrincipalArn": ${break_glass_arns}
        }
      }
    }
  ]
}
